    //Registration Cancelled
    public function registrationCancel(Request $request)
    {
        DB::beginTransaction();
        try {
            $form_no = $request->form_no;
            $reg_no = $request->reg_no;
            $remarks = $request->remarks;

            $student = Registerstudent::where('s_appl_form_num', $form_no)
                ->where('s_appl_reg_no', $reg_no)
                ->where('is_active', 1)->first();
            if (!$student) {
                return response()->json([
                    'error' => true,
                    'message' => 'Student not found'
                ], 404);
            }
            $update_data = [];
            $message = '';
            $update_data = [
                's_part1_status' => 9,
                's_registration_cancel' => 1,
                's_reg_cancel_reason' => $remarks

            ];
            $message = 'Student Form no. ' . $form_no . ' registration is cancelled';

            Registerstudent::where('s_appl_form_num', $form_no)
                ->where('s_appl_reg_no', $reg_no)->update($update_data);

            DB::commit();

            auditTrail(authUserId(), "{$message}");
            return response()->json([
                'error' => false,
                'message' => $message,
            ], 200);
        } catch (\Exception $e) {
            DB::rollback();
            return response()->json([
                'status' => 'error',
                'message' => 'Error eligible status updating: ' . $e->getMessage()
            ], 500);
        }

    }

