                'message' => 'Failed to fetch student list: ' . $e->getMessage(),
            ], 500);
        }

    }

    public function generateRegNo(Request $request)
    {
        try {
            DB::beginTransaction();
            $form_id = $request->form_id_array;
            $students = Registerstudent::whereIn('s_appl_form_num', $form_id)->get();
            $counter = 1;
            foreach ($students as $formid) {
                if ($formid->s_appl_reg_no) {
                    return response()->json([
                        'status' => 'error',
                        'message' => "Registration number already generated for {$formid->s_appl_form_num}!",
                    ], 400);
                }

                $lastRegistration = Registerstudent::where('s_appl_sess_year', $formid->s_appl_sess_year)
                    ->whereNotNull('s_appl_reg_no')
                    ->where('is_active', 1)
                    ->orderBy('s_appl_reg_no', 'desc')
                    ->first();

                if ($lastRegistration && $lastRegistration->s_appl_reg_no) {
                    $lastNumber = substr($lastRegistration->s_appl_reg_no, -5);
                    $counter = (int) $lastNumber + 1;
                }

                $sessionParts = explode('-', $formid->s_appl_sess_year);
                $sessionCode = substr($sessionParts[0], -2) . substr($sessionParts[1], -2);
                $prefix = 'PHARM' . $sessionCode;
                $registrationId = $prefix . str_pad($counter, 5, '0', STR_PAD_LEFT);

                Registerstudent::where('s_appl_form_num', $formid->s_appl_form_num)->where('is_active', 1)->update([
                    's_appl_reg_no' => $registrationId,
                    's_appl_reg_year' => $formid->s_appl_sess_year,
                    's_part1_status' => 2,
                ]);

                auditTrail(authUserId(), "Form Number {$formid->s_appl_form_num} {$formid->s_candidate_name} Registration Number Generated Successfully.");
                // $this->sendMail(
                //     $formid->s_candidate_name,
                //     $formid->s_appl_form_num,
                //     $formid->s_email,
                //     $registrationId
                // );
                $counter++;
            }

            DB::commit();

            return response()->json([
                'status' => 'success',
                'message' => 'Registration number(s) generated successfully!',
            ]);
        } catch (\Exception $e) {
            DB::rollback();

            return response()->json([
                'status' => 'error',
                'message' => 'Error generating registration number(s): ' . $e->getMessage(),
            ], 500);
        }




    }

